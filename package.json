{
  "name": "chispaconcalma",
  "private": true,
  "type": "module",
  "description": "Chispa con Calma website and local content research",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "format": "prettier --write src scripts/staging tests astro.config.mjs cloudflare.config.ts playwright.config.ts",
    "format:check": "prettier --check src scripts/staging tests astro.config.mjs cloudflare.config.ts playwright.config.ts",
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "validate": "pnpm format:check && pnpm check && pnpm test && pnpm build && pnpm test:e2e",
    "staging:metadata": "node scripts/staging/metadata.mjs",
    "staging:validate": "node scripts/staging/validate-assets.mjs dist",
    "staging:dry-run": "cf deploy ./dist --dry-run"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/cli": "^0.1.24",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cf": "1.0.0-rc.2",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "astro": "^7.4.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
